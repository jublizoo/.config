layout {
	// gaps 16
	gaps 50
	background-color "transparent"

	center-focused-column "never"

	preset-column-widths {
		proportion 0.33333
		proportion 0.5
		proportion 0.66667
	}

	default-column-width { proportion 0.5; }

	focus-ring {
		width 2
		active-color "#7fc8ff"
		inactive-color "#505050"
		active-gradient from="#7fc8ff" to="bf1be8" angle=45 in="srgb"
	}

	border {
		off
	}

	shadow {
		softness 30
		spread 5
		offset x=0 y=5
		color "#0007"
	}

	struts {
	}

	tab-indicator {
        hide-when-single-tab
        gap 5
        width 6
        length total-proportion=0.5
        gaps-between-tabs 10
        corner-radius 8
        active-color "#7fc8ff"
        inactive-color "#404040"
        urgent-color "red"
	}
}
